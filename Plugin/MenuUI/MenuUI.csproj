<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MenuUI</AssemblyName>
    <RootNamespace>MenuUI</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    Paths — set these in a local Directory.Build.props or adjust below.
    Example Directory.Build.props:
      <UnturnedPath>C:/Program Files (x86)/Steam/steamapps/common/Unturned</UnturnedPath>
      <RocketPath>$(UnturnedPath)/Modules/Rocket.Unturned/Libraries</RocketPath>
  -->
  <PropertyGroup>
    <UnturnedManaged>$(UnturnedPath)/Unturned_Data/Managed</UnturnedManaged>
    <RocketLibs>$(RocketPath)</RocketLibs>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(UnturnedManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(UnturnedManaged)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnturnedManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnturnedManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnturnedManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rocket.API">
      <HintPath>$(RocketLibs)/Rocket.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rocket.Core">
      <HintPath>$(RocketLibs)/Rocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rocket.Unturned">
      <HintPath>$(RocketLibs)/Rocket.Unturned.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
